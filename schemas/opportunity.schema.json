{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os.local/schemas/opportunity.schema.json",
  "title": "Workflow OS OpportunityContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id",
    "source_platform",
    "campaign_id",
    "title",
    "category",
    "allowed_countries",
    "platforms",
    "source_assets",
    "usage_rights",
    "disclosure_requirements",
    "deadline",
    "remaining_budget",
    "payout_formula",
    "minimum_thresholds",
    "payout_cap",
    "payment_method",
    "approval_rules",
    "originality_requirements",
    "account_requirements",
    "expected_production_cost",
    "estimated_success_probability",
    "expected_revenue",
    "expected_collectible_revenue",
    "expected_net_profit",
    "expected_profit_per_laptop_hour",
    "compliance_risk",
    "platform_risk",
    "duplicate_conflict_status",
    "user_attention_requirement",
    "source_checked_at",
    "freshness_ttl_seconds",
    "rights_verification_state",
    "status"
  ],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "source_platform": {"type": "string", "minLength": 1},
    "campaign_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "allowed_countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "platforms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_assets": {"type": "array", "items": {"type": "string"}},
    "usage_rights": {"type": "string"},
    "disclosure_requirements": {"type": "array", "items": {"type": "string"}},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "remaining_budget": {"type": ["number", "null"], "minimum": 0},
    "payout_formula": {"type": "string"},
    "minimum_thresholds": {"type": "object"},
    "payout_cap": {"type": ["number", "null"], "minimum": 0},
    "payment_method": {"type": ["string", "null"]},
    "approval_rules": {"type": "string"},
    "originality_requirements": {"type": "string"},
    "account_requirements": {"type": "array", "items": {"type": "string"}},
    "expected_production_cost": {"type": "number", "minimum": 0},
    "expected_laptop_minutes": {"type": "number", "minimum": 0, "default": 0},
    "expected_owner_minutes": {"type": "number", "minimum": 0},
    "estimated_success_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "probability_collection": {"type": "number", "minimum": 0, "maximum": 1},
    "expected_revenue": {"type": "number", "minimum": 0},
    "expected_collectible_revenue": {"type": "number", "minimum": 0},
    "expected_net_profit": {"type": "number"},
    "expected_profit_per_laptop_hour": {"type": "number"},
    "time_to_cash_days": {"type": ["number", "null"], "minimum": 0},
    "capital_at_risk": {"type": "number", "minimum": 0, "default": 0},
    "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
    "compliance_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCKED"]},
    "platform_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCKED"]},
    "duplicate_conflict_status": {"enum": ["CLEAR", "DUPLICATE", "CONFLICT", "UNKNOWN"]},
    "user_attention_requirement": {"enum": ["NONE", "OWNER_APPROVAL", "KYC", "EXCEPTION", "EMERGENCY"]},
    "rights_verification_state": {"enum": ["VERIFIED", "CLAIMED_UNVERIFIED", "UNKNOWN", "REJECTED", "EXPIRED"]},
    "discovered_at": {"type": ["string", "null"], "format": "date-time"},
    "source_checked_at": {"type": "string", "format": "date-time"},
    "terms_hash": {"type": ["string", "null"]},
    "budget_checked_at": {"type": ["string", "null"], "format": "date-time"},
    "freshness_ttl_seconds": {"type": "integer", "minimum": 0},
    "status": {"enum": ["DISCOVERED", "REVALIDATE", "ACCEPTED", "QUEUED", "RUNNING", "PAUSED", "REJECTED", "EXPIRED", "COMPLETED"]}
  }
}
