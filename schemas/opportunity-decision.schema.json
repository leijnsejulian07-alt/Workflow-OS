{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os.local/schemas/opportunity-decision.schema.json",
  "title": "Workflow OS OpportunityDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunity_id", "decision", "decision_reasons", "eligible_for_queue", "economic_score", "priority_score", "requires_revalidation", "evaluated_at", "policy_version"],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ACCEPT", "REVALIDATE", "PAUSE", "REJECT"]},
    "decision_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "eligible_for_queue": {"type": "boolean"},
    "economic_score": {"type": "number"},
    "priority_score": {"type": "number"},
    "requires_revalidation": {"type": "boolean"},
    "revalidation_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "owner_attention_requirement": {"enum": ["NONE", "OWNER_APPROVAL", "KYC", "EXCEPTION", "EMERGENCY"]},
    "expected_collectible_revenue": {"type": "number", "minimum": 0},
    "expected_net_profit": {"type": "number"},
    "expected_profit_per_laptop_hour": {"type": "number"},
    "estimated_total_cost": {"type": "number", "minimum": 0},
    "risk_penalty": {"type": "number", "minimum": 0},
    "freshness_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1}
  }
}
